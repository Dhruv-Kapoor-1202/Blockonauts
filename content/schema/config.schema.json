{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "low": {
          "type": "number"
        },
        "critical": {
          "type": "number"
        },
        "ariaAlert": {
          "type": "number"
        },
        "ariaTip": {
          "type": "number"
        }
      },
      "required": [
        "low",
        "critical",
        "ariaAlert",
        "ariaTip"
      ],
      "additionalProperties": false
    },
    "daily": {
      "type": "object",
      "properties": {
        "criticalHealthPenalty": {
          "type": "number"
        }
      },
      "required": [
        "criticalHealthPenalty"
      ],
      "additionalProperties": false
    },
    "randomEvents": {
      "type": "object",
      "properties": {
        "chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "afterDay": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "chance",
        "afterDay"
      ],
      "additionalProperties": false
    },
    "interludes": {
      "type": "object",
      "properties": {
        "recentMemoryMax": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "recentMemoryReserve": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "helpBias": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "winNextDelay": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "recentMemoryMax",
        "recentMemoryReserve",
        "helpBias",
        "winNextDelay"
      ],
      "additionalProperties": false
    },
    "scoring": {
      "type": "object",
      "properties": {
        "perDay": {
          "type": "number"
        },
        "perFact": {
          "type": "number"
        },
        "perAchievement": {
          "type": "number"
        },
        "winBonus": {
          "type": "number"
        },
        "perChapterCleared": {
          "type": "number"
        },
        "perRetry": {
          "type": "number"
        }
      },
      "required": [
        "perDay",
        "perFact",
        "perAchievement",
        "winBonus",
        "perChapterCleared",
        "perRetry"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "max"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "thresholds",
    "daily",
    "randomEvents",
    "interludes",
    "scoring",
    "notes"
  ],
  "additionalProperties": false
}
