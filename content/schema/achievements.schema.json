{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "achievements": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "dayAtLeast"
                  },
                  "day": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "type",
                  "day"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "counterAtLeast"
                  },
                  "counter": {
                    "type": "string",
                    "enum": [
                      "science",
                      "facts"
                    ]
                  },
                  "value": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "type",
                  "counter",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "event"
                  },
                  "event": {
                    "type": "string",
                    "enum": [
                      "phaseWeathered",
                      "supplyLanded",
                      "missionWon"
                    ]
                  }
                },
                "required": [
                  "type",
                  "event"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "balanced"
                  },
                  "afterDay": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "minEach": {
                    "type": "number"
                  }
                },
                "required": [
                  "type",
                  "afterDay",
                  "minEach"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "rule"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "achievements"
  ],
  "additionalProperties": false
}
